@page "/"

@using System.Globalization;
@using Music4LifeKaraokeSongbookApp.Client.Services

@inject IMusic4LifeSongbookService music4LifeSongbookService
@inject IAskDJHandler askDJHandler
@inject IJSRuntime jsRuntime
@inject ISnackbar snackbar

<MudCard Class="pa-1">
    <MudCardMedia Image="images/logo.png" Height="100" />
    <MudSpacer />
</MudCard>


<MudCard Class="pa-1">
    <MudCardContent Class="pa-1">
        <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert>
             <MudTabs Centered AlwaysShowScrollButtons Rounded @bind-ActivePanelIndex="activeIndex">
                <MudTabPanel Text="Português" OnClick="@( () => GetSongbookFromLanguage((Language)(activeIndex + 1)))">
                </MudTabPanel>
                <MudTabPanel Text="Brasileiro" OnClick="@( () => GetSongbookFromLanguage((Language)(activeIndex + 1)))">
                </MudTabPanel>
                <MudTabPanel Text="Africano" OnClick="@( () => GetSongbookFromLanguage((Language)(activeIndex + 1)))">
                </MudTabPanel>
                <MudTabPanel Text="Espanhol" OnClick="@( () => GetSongbookFromLanguage((Language)(activeIndex + 1)))">
                </MudTabPanel>
                <MudTabPanel Text="Italiano" OnClick="@( () => GetSongbookFromLanguage((Language)(activeIndex + 1)))">
                </MudTabPanel>
                <MudTabPanel Text="Francês" OnClick="@( () => GetSongbookFromLanguage((Language)(activeIndex + 1)))">
                </MudTabPanel>
                <MudTabPanel Text="Alemão" OnClick="@( () => GetSongbookFromLanguage((Language)(activeIndex + 1)))">
                </MudTabPanel>
                <MudTabPanel Text="Inglês" OnClick="@( () => GetSongbookFromLanguage((Language)(activeIndex + 1)))">
                </MudTabPanel>
            </MudTabs>
        </MudHidden>

         <MudHidden Breakpoint="Breakpoint.Xs" Invert>
             <div class="d-flex justify-content-end align-items-center gap-3">
            <!-- <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Large" Color="Color.Primary"></MudIcon> -->
                <MudText Typo="Typo.h6">Músicas em </MudText>
            <MudMenu FullWidth Class="d-flex justify-content-end" Label="@selectedLanguage" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Variant="Variant.Outlined" Color="Color.Primary" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopLeft">
                 <MudMenuItem Class="language-selector" OnClick="@( () => GetSongbookFromLanguage(Language.Portuguese))">
                     Português
                 </MudMenuItem>
                 <MudMenuItem Class="language-selector" OnClick="@( () => GetSongbookFromLanguage(Language.Brazilian))">
                     Brasileiro
                 </MudMenuItem>
                 <MudMenuItem Class="language-selector"  OnClick="@( () => GetSongbookFromLanguage(Language.African))">
                     Africano
                 </MudMenuItem>
                 <MudMenuItem Class="language-selector"  OnClick="@( () => GetSongbookFromLanguage(Language.Spanish))">
                     Espanhol
                 </MudMenuItem>
                 <MudMenuItem Class="language-selector"  OnClick="@( () => GetSongbookFromLanguage(Language.Italian))">
                     Italiano
                 </MudMenuItem>
                 <MudMenuItem Class="language-selector" OnClick="@( () => GetSongbookFromLanguage(Language.French))">
                     Francês
                 </MudMenuItem>
                 <MudMenuItem Class="language-selector"  OnClick="@( () => GetSongbookFromLanguage(Language.German))">
                     Alemão
                 </MudMenuItem>
                 <MudMenuItem Class="language-selector"  OnClick="@( () => GetSongbookFromLanguage(Language.English))">
                     Inglês
                 </MudMenuItem>
            </MudMenu>
             </div>
        </MudHidden>

            <MudTextField 
                @bind-Value="songFilter"
                Placeholder="Pesquisar"
                Class="mt-8 mb-4"
                Typo="Typo.h6"
                Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Search"
                IconSize="Size.Large" Variant="Variant.Outlined"
                HelperTextOnFocus
                HelperText="Pesquisa pelo nome da música ou do interprete"
                DebounceInterval="750"
                Clearable />
            <MudTable 
                @ref="@_songbookTable"
                Breakpoint="Breakpoint.None"
                Items="@languageSongbook.Songs" 
                Filter="new Func<SongDb, bool>(SearchTableSong)" 
                GroupBy="@_groupDefinition" 
                Dense
                Loading="@loading"
                LoadingProgressColor="@Color.Warning"
                GroupHeaderClass="group-header-m4l"
                HeaderClass="header-m4l"
                FooterClass="mud-table-pagination-toolbar__m4l"
                RowsPerPage="50"
            >
                <HeaderContent>
                    <MudTh>Interprete</MudTh>
                    <MudTh>Música</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <GroupHeaderTemplate>
                    <MudTh Class="mud-table-cell-custom-group" colspan="3">@($"{context.Key}")</MudTh>
                </GroupHeaderTemplate>
                <RowTemplate>
                    <MudTd></MudTd>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@( () => OpenRequestDialog(context))" Disabled="@openingRequestDialog">
                            Pedir Música
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    Não temos essa música. Procura outra...
                </NoRecordsContent>
                <LoadingContent>
                    A carregar...
                </LoadingContent>
                <PagerContent>
                    <M4LKaraokeSongbook.MudTablePager 
                        Class="mud-table-pager-m4l"
                        PageSizeOptions="new int[] { 50, 100, 200, int.MaxValue }"
                        Sizew
                        HorizontalAlignment="HorizontalAlignment.Center" 
                        RowsPerPageString="Músicas por página:" 
                        InfoFormat="{first_item}-{last_item} Total:{all_items}" />
                </PagerContent>
            </MudTable>
    </MudCardContent>
</MudCard>

<MudDialog @bind-Visible="requestDialogVisible" Options="requestDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Pedir Música</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">@selectedSong?.SingerName - @selectedSong?.Name</MudText>
        @if (selectedSong is not null && $"{selectedSong.SingerName} - {selectedSong.Name}".Length > AskDJRequest.MaxMessageLength)
        {
            <MudText Color="Color.Error">O resumo da música não pode exceder 500 caracteres.</MudText>
        }
        <MudTextField @bind-Value="requesterName" Label="O teu nome" Variant="Variant.Outlined"
                      Class="mt-4" Immediate="true" Disabled="@requestInProgress" Required="true"
                      MaxLength="@AskDJRequest.MaxNameLength"
                      Error="@(requesterName.Length > AskDJRequest.MaxNameLength)"
                      ErrorText="O nome não pode exceder 100 caracteres." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseRequestDialog" Disabled="@requestInProgress">Fechar</MudButton>
        <MudButton OnClick="ConfirmRequest" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(requestInProgress || !IsRequestValid())">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string songFilter = null!;
    private IEnumerable<SongDb>? songbookSearched = [];
    private readonly DialogOptions requestDialogOptions = new() { BackdropClick = false, CloseOnEscapeKey = false };
    private SongDb? selectedSong;
    private string requesterName = string.Empty;
    private bool requestDialogVisible;
    private bool openingRequestDialog;
    private bool requestInProgress;

    private Songbook songbook = new();
    private Songbook languageSongbook = new();

    private MudTableBase? _songbookTable = null;

    private bool loading = true;
    private int activeIndex = 0;
    private string? selectedLanguage = GetLanguageName(Language.Portuguese);


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetSongbook();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task GetSongbook()
    {
        songbook = (await music4LifeSongbookService.GetSongbookAsync())!;

        await GetSongbookFromLanguage();
    }

    private async Task GetSongbookFromLanguage(Language language = Language.Portuguese)
    {
        int languageCodeOffset = 1;

        int languageIndex = (int)language - languageCodeOffset;

        if (activeIndex != languageIndex)
        {
            activeIndex = languageIndex;
        }

        selectedLanguage = GetLanguageName(language);

        languageSongbook.Songs = songbook?.Songs?.Where(x => x.LanguageId == language).ToList();

        _songbookTable.NavigateTo(Page.First);

        loading = false;

        await InvokeAsync(StateHasChanged);
    }

    private bool SearchTableSong(SongDb song) => FilterFunc(song, songFilter);

    private bool FilterFunc(SongDb song, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        CompareInfo compareInfo = CultureInfo.CurrentCulture.CompareInfo;

        int indexName = compareInfo.IndexOf(song.Name, searchString, CompareOptions.IgnoreNonSpace | CompareOptions.IgnoreCase);
        int indexSinger = compareInfo.IndexOf(song.SingerName, searchString, CompareOptions.IgnoreNonSpace | CompareOptions.IgnoreCase);

        return indexName >= 0 || indexSinger >= 0;
    }

    private async Task<IEnumerable<SongDb>> SearchSong(string value)
    {
        await Task.Delay(5);

        CompareInfo compareInfo = CultureInfo.CurrentCulture.CompareInfo;

        if (string.IsNullOrEmpty(value)) {
            songbookSearched = songbook.Songs.OrderBy( x => x.LanguageId).ThenBy(x => x.SingerName).ThenBy(x => x.Name);
            return songbookSearched;
        }

        songbookSearched = songbook.Songs
            .Where(
                x =>
                {
                    int indexName = compareInfo.IndexOf(x.Name, value, CompareOptions.IgnoreNonSpace | CompareOptions.IgnoreCase);
                    int indexSinger = compareInfo.IndexOf(x.SingerName, value, CompareOptions.IgnoreNonSpace | CompareOptions.IgnoreCase);

                    return indexName >= 0  || indexSinger >= 0;
                })
            .OrderBy( x => x.SingerName).ThenBy( x => x.Name );

        return songbookSearched;
    }

    private TableGroupDefinition<SongDb> _groupDefinition = new()
        {
            GroupName = "Cantor",
            Expandable = false,
            Selector = (e) => e.SingerName
        };

    public static string GetLanguageName(Language language)
    {
        switch (language)
        {
            case Language.Portuguese:
                return "Português";
            case Language.Brazilian:
                return "Brasileiro";
            case Language.African:
                return "Africano";
            case Language.Spanish:
                return "Espanhol";
            case Language.Italian:
                return "Italiano";
            case Language.French:
                return "Francês";
            case Language.German:
                return "Alemão";
            case Language.English:
                return "Inglês";
            default:
                return "Error";
        }
    }

    private async Task OpenRequestDialog(SongDb song)
    {
        if (openingRequestDialog || requestInProgress)
            return;

        openingRequestDialog = true;
        selectedSong = song;
        requesterName = string.Empty;

        try
        {
            requesterName = await jsRuntime.InvokeAsync<string?>("getRequesterName") ?? string.Empty;
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Error reading requester name: {ex.Message}");
            snackbar.Add("Não foi possível carregar o nome guardado.", Severity.Warning);
        }
        finally
        {
            openingRequestDialog = false;
        }

        requestDialogVisible = true;
    }

    private void CloseRequestDialog()
    {
        requestDialogVisible = false;
    }

    private bool IsRequestValid() =>
        selectedSong is not null &&
        !string.IsNullOrWhiteSpace(requesterName) &&
        requesterName.Length <= AskDJRequest.MaxNameLength &&
        $"{selectedSong.SingerName} - {selectedSong.Name}".Length <= AskDJRequest.MaxMessageLength;

    private async Task ConfirmRequest()
    {
        if (requestInProgress || !IsRequestValid() || selectedSong is null)
            return;

        requestInProgress = true;
        var name = requesterName.Trim();
        var songRequest = new AskDJRequest
        {
            Name = name,
            Message = $"{selectedSong.SingerName} - {selectedSong.Name}"
        };

        try
        {
            try
            {
                await jsRuntime.InvokeVoidAsync("setRequesterName", name);
            }
            catch (JSException ex)
            {
                Console.WriteLine($"Error saving requester name: {ex.Message}");
                snackbar.Add("Não foi possível guardar o nome neste dispositivo.", Severity.Warning);
            }

            if (await askDJHandler.RequestASongAsync(songRequest))
            {
                requestDialogVisible = false;
                snackbar.Add("Pedido de música enviado.", Severity.Success);
            }
            else
            {
                snackbar.Add("Não foi possível enviar o pedido de música. Tenta novamente.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error requesting song: {ex.Message}");
            snackbar.Add("Não foi possível enviar o pedido de música. Tenta novamente.", Severity.Error);
        }
        finally
        {
            requestInProgress = false;
        }
    }
}

<style>
    .group-header-m4l * {
        background-color: var(--mud-palette-background-grey) !important;
        font-size: 1.5rem !important;
        font-variant-caps: all-small-caps;
    }

    .header-m4l * {
        background-color: var(--mud-palette-primary) !important;
        color: var(--mud-palette-dark-text) !important;
        font-weight: 900;
        line-height: 1.5rem;
        font-variant-caps: all-small-caps;
        font-size: 1.35rem !important;
    }
    
    td {
        font-weight: 300 !important;
        font-size: 1.3rem !important;
        font-variant-caps: all-small-caps;
    }

    .language-selector {
        width: 100%;
    }

    .mud-table-pager-m4l {
        justify-content: space-between;
    }


    @@media (max-width: 600px) {

        .mud-table-pagination-toolbar {
    
           height: fit-content;
           flex-wrap: wrap;
        }
    }
    
</style>
